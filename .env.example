# cp .env.example .env ile kopyala, gercek degerleri yaz. Bu dosya
# docker-compose.yml'in okudugu degiskenleri belgeler -- .env git'e
# girmez (bkz. .gitignore), gercek deploy'da sunucuya ELLE kopyalanir.

# --- Postgres ---
POSTGRES_DB=appointment_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=BURAYA_GUCLU_BIR_PAROLA_YAZ

# --- Backend ---
# En az 32 byte rastgele deger: openssl rand -base64 32
JWT_SECRET=BURAYA_OPENSSL_ILE_URETTIGIN_SECRET
# Ayni origin'de Caddy kullanildigi icin deployed frontend bu degeri
# GERCEKTE kullanmiyor (bkz. CLAUDE.md/ROADMAP, Faz 3.7 CORS karari) --
# yine de fail-fast icin ve ileride cross-origin bir istemci (mobil uygulama
# vb.) gelirse diye dolu tutuluyor. Gercek prod domain'in.
CORS_ALLOWED_ORIGINS=https://BURAYA_GERCEK_DOMAIN_YAZ

# --- Caddy ---
# Gercek domain (ornegin randevum.com) -- Caddy bunun icin otomatik HTTPS
# sertifikasi alir. Yerel testte bos birakilirsa docker-compose.yml
# varsayilani (":80", duz HTTP) kullanilir.
DOMAIN=BURAYA_GERCEK_DOMAIN_YAZ
# www -> apex yonlendirmesi icin (bkz. Caddyfile). RUNBOOK.md A5'teki sed
# komutu BURAYA_GERCEK_DOMAIN_YAZ'i degistirirken bu satiri da otomatik
# dogru degere getirir, ayrica elle duzenlemeye gerek yok.
WWW_DOMAIN=www.BURAYA_GERCEK_DOMAIN_YAZ
