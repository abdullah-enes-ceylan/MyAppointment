<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.7</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.randevu</groupId>
	<artifactId>backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name/>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>
	</properties>

	<!-- spring-boot-dependencies (4.0.7) testcontainers.version'i 2.0.5'e
	     sabitliyor ama o surum Maven Central'da hic yayinlanmamis (Spring
	     Boot 4.0.7'nin kendisi cok yeni bir surum, muhtemelen upstream bir
	     hata/senkronizasyon sorunu); org.testcontainers:testcontainers,
	     :postgresql, :junit-jupiter icin "artifact bulunamadi" hatasi
	     veriyordu. Burada testcontainers-bom'u GERCEKTEN var olan bir
	     surumle (1.21.4) yeniden import ediyoruz; projenin kendi
	     dependencyManagement'i miras alinandan daha "yakin" sayildigi icin
	     bu surum, spring-boot-testcontainers'in transitive olarak cektigi
	     org.testcontainers:testcontainers'i da (dogrudan bagimlilik olarak
	     hic yazmadan) gecersiz kilip dogru surumle degistiriyor. -->
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.testcontainers</groupId>
				<artifactId>testcontainers-bom</artifactId>
				<version>1.21.4</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
	
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<!-- Faz 3.6: /actuator/health icin, deploy platformunun (ileride secilecek,
		     bkz. Faz 3.8) uygulamanin ayakta olup olmadigini anlamasi icin.
		     management.endpoints.web.exposure.include=health ile SADECE health
		     aciliyor; varsayilan zaten "sadece health" olsa da bunu ELLE ve ACIKCA
		     yazmak, ileride baska bir starter/otomatik yapilandirma bu varsayilani
		     degistirirse (ornegin butun endpoint'leri acan bir profil eklenirse)
		     sessizce genislemesini engelliyor. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!-- Bean Validation: @NotBlank, @Email, @Size, @Future gibi anotasyonlari
		     etkinlestirir. Bu olmadan @Valid hicbir sey yapmaz, sessizce yok sayilir. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Semayi artik Hibernate'in ddl-auto'su degil, elle yazilmis
		     migration'lar (src/main/resources/db/migration) yonetiyor.
		     H2 buradan kaldirildi: Faz 3.1'de test stratejisi zaten
		     Testcontainers ve gercek Postgres olacak (H2, Postgres'ten
		     farkli davranir), H2'yi fallback olarak tutmanin bir
		     anlami kalmadi. -->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<!-- Faz 3.1: BackendApplicationTests artik kullanicinin yerel/native
		     Postgres kurulumuna degil, testin kendi actigi/kapattigi
		     TEK KULLANIMLIK bir Docker Postgres container'ina bagliyor.
		     Boylece context'in ve Flyway migration'larinin GERCEKTEN
		     tertemiz bir semada calistigi dogrulaniyor, gelistiricinin
		     makinesindeki (zamanla elle mudahale edilmis olabilecek)
		     kalici veritabaniyla degil. Versiyon spring-boot-dependencies
		     BOM'undan geliyor, elle sabitlenmedi. H2 BILEREK kullanilmadi:
		     partial unique index, CHECK constraint ve FOR UPDATE kilidi
		     gibi ozelliklerde Postgres'ten farkli davranip yanlis guven
		     verirdi (bkz. yukaridaki Flyway yorumu, ayni gerekce). Surum
		     yukaridaki dependencyManagement'ten geliyor (bkz. o blogun
		     aciklamasi). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>postgresql</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- 1. Spring Security: Projenin kapısındaki güvenlik görevlisi -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- 2. JWT (JSON Web Token) Kütüphaneleri: Kimlik kartı üretici ve doğrulayıcı -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.5</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.5</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.5</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Isletme kapak fotografi: kaliteli resize + EXIF orientation/temizligi
             tek satirda. Bkz. BusinessPhotoService, plan madde 5. -->
        <dependency>
            <groupId>net.coobird</groupId>
            <artifactId>thumbnailator</artifactId>
            <version>0.4.21</version>
        </dependency>

        <!-- Isletme kapak fotografi depolamasini yerel diskten Cloudflare R2'ye
             tasima (bkz. NOTLAR.md "R2'ye tasima" karari). R2, S3 API'siyle
             uyumlu oldugu icin AWS'in kendi SDK'sini farkli bir endpoint'e
             isaret ederek kullaniyoruz; ayri bir R2-ozel istemci yok.
             url-connection-client BILEREK secildi: varsayilan (Apache/Netty
             tabanli) HTTP istemcileri yerine, senkron ve tek-istek-bazli bu
             kullanim (yukleme/silme, yuksek eszamanlilik degil) icin en hafif
             secenek; gereksiz reaktif/async yigin bagimliligi eklemiyor. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <version>2.46.7</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>url-connection-client</artifactId>
            <version>2.46.7</version>
        </dependency>

        <!-- Faz 3.3: API dokumantasyonu (Swagger UI + OpenAPI semasi).
             springdoc-openapi'nin 2.x hatti Spring Boot 3.x'i hedefliyor,
             3.x hatti Spring Boot 4.x icin; testcontainers-bom'daki surum
             sabitleme sorunuyla ayni gerekce, bu projenin cok yeni bir
             Spring Boot surumu kullanmasi. Elle sabitlenen 3.1.0, bu
             satir yazilirken Maven Central'daki en yeni surum. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.1.0</version>
        </dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<executions>
					<execution>
						<id>default-compile</id>
						<phase>compile</phase>
						<goals>
							<goal>compile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
					<execution>
						<id>default-testCompile</id>
						<phase>test-compile</phase>
						<goals>
							<goal>testCompile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- reuseForks=false: her test SINIFI kendi taze JVM'inde
			     calisir, bir onceki sinifla ayni JVM'i (dolayisiyla
			     AbstractIntegrationTest'in paylasilan static Postgres
			     container'ini) PAYLASMAZ. Varsayilan (reuseForks=true) ile
			     Testcontainers tabanli TUM siniflar (BackendApplicationTests,
			     *IntegrationTest) ayni container'i, ayni JVM oturumu boyunca
			     (birkac dakika) paylasiyordu; bu uzun paylasilan oturumda
			     Testcontainers'in Ryuk reaper'i (Windows Docker Desktop'ta)
			     JVM ile baglantiyi kaybedip container'i signal=9 ile
			     oldurmeye basladi (docker events ile dogrulandi: container
			     tam basarisiz olan test sinifinin surdugu kadar yasayip
			     olduruluyordu). Her sinif kendi JVM'inde, kendi kisa omurlu
			     container'inda calisinca bu kumulatif oturum riski ortadan
			     kalkiyor; bedeli JVM baslatma/container acma maliyetinin
			     sinif basina bir kez daha odenmesi, bu projenin test
			     sayisinda (~15 sinif) ihmal edilebilir. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<reuseForks>false</reuseForks>
					<forkCount>1</forkCount>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
