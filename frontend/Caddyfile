# Domain, ortam degiskeninden geliyor -- docker-compose.yml'de DOMAIN olarak
# gecirilecek (yerel testte ":80" gibi bir deger de calisir, Caddy bunu HTTP
# icin bir port olarak yorumlar; gercek bir domain verilince otomatik HTTPS
# devreye girer, ayrica bir sertifika adimi gerekmez).
{$DOMAIN} {
	# Guvenlik header'lari -- Caddy bunlari OTOMATIK EKLEMIYOR, sadece
	# otomatik HTTPS/HTTP->HTTPS yonlendirmesi yapiyor. Ayri ayri gerekce:
	#   Strict-Transport-Security: tarayiciya "bu domain'e bir daha ASLA
	#     duz HTTP ile gitme" der -- ilk ziyarette bile downgrade/mitm
	#     saldirisini zorlastirir. Sadece HTTPS baglaminda anlamli, duz
	#     HTTP'de tarayici bu header'i zaten yok sayar (yerel testte
	#     zararsiz). max-age BILEREK KISA (300sn) -- Faz 3.8 ilk deploy
	#     haftasinda HTTPS/sertifikada bir sorun cikarsa, UZUN bir max-age
	#     tarayicilarin duz HTTP'ye dusmesine hic izin vermez ve tum test
	#     cihazlarinda (ozellikle zaten bir kez ziyaret etmis olanlarda)
	#     sikisip kalinir -- bu GERI ALINAMAZ bir hata sinifi, sertifika
	#     hatasi gibi normalde kolayca duzeltilebilecek bir sorunu haftalar
	#     suren bir tarayici-onbellegi sorununa cevirir. RUNBOOK.md'nin
	#     "Ilk 48 Saat" bolumundeki stabilite penceresi gecince (yani sistem
	#     kanitlanmis sekilde guvenilir calisiyorken) buraya donup
	#     `max-age=31536000; includeSubDomains` degerine yukseltilecek.
	#     `preload` DIREKTIFI BILEREK YOK -- Chrome/Firefox/Safari'nin HSTS
	#     preload listesine girmek aylar surer, LISTEDEN CIKMAK da oyle;
	#     beta oncesi bir sistemde bu geri donusu neredeyse imkansiz riski
	#     almanin hicbir faydasi yok.
	#   X-Content-Type-Options: tarayicinin, sunucunun bildirdigi
	#     Content-Type'i "tahmin ederek" degistirmesini (MIME sniffing)
	#     engeller -- ornegin bir kullanicinin yukledigi dosyanin
	#     calistirilabilir bir tur gibi yorumlanmasini onler.
	#   X-Frame-Options: bu siteyi baska bir sitenin <iframe>'i icine
	#     gomulmekten korur (clickjacking).
	#   Referrer-Policy: baska bir siteye giden linklerde tam URL yerine
	#     sadece origin gonderilir -- query string/path'teki hassas
	#     bilgi (ornegin token) 3. taraf sitelere sizmaz.
	# X-XSS-Protection BILEREK eklenmedi -- modern tarayicilarda kaldirilan,
	# artik CSP ile cozulen eski bir mekanizma; onermek yanlis olurdu.
	# Content-Security-Policy da bilerek eklenmedi -- bu uygulamaya ozel
	# dikkatli ayarlanmasi gereken ayri bir is (inline script/style,
	# font kaynaklari vb. tek tek gozden gecirilmeli), yanlis/gevsek bir
	# CSP hicbir sey eklemez, cok siki bir CSP ise siteyi bozar.
	header {
		Strict-Transport-Security "max-age=300"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# API ve actuator istekleri backend container'ina -- docker-compose'un
	# ic agi uzerinden servis adiyla (postgres:5432 ile ayni desen).
	#
	# request_body max_size: Spring'in KENDI govde siniri
	# (spring.servlet.multipart.max-file-size=8MB) yalnizca istek backend'e
	# ULASTIKTAN sonra devreye giriyor -- Caddy'nin onunde HICBIR govde
	# sinirinin olmamasi, cok daha buyuk (ornegin 500MB) bir govdenin
	# backend'e (ve oradan Tomcat'e) tasinmasina izin verirdi, bu da
	# bant genisligi/bellek tuketen ucuz bir DoS deseni olurdu. 10MB --
	# 8MB'lik servlet sinirinin HAFIFCE USTUNDE (ayni gerekce:
	# BusinessPhotoProperties.maxSizeBytes < servlet siniri < Caddy siniri --
	# her katman bir oncekinden biraz gevsek, boylece normal-boyuttaki bir
	# istek HER ZAMAN bir sonraki, daha anlamli hata mesaji ureten katmana
	# ulasir).
	handle /api/* {
		request_body {
			max_size 10MB
		}
		reverse_proxy backend:8080
	}
	# "/actuator" (sonunda / olmadan, sondaki segment olmadan) /actuator/*
	# kalibina UYMUYOR -- canli testte yakalandi: bu path SPA fallback'ine
	# dusup index.html donduruyordu (veri sizmiyor ama tutarsizdi). handle
	# tek bir path deseni alabiliyor, o yuzden named matcher ile ikisini
	# birden tanimliyoruz (ilk denemede handle'a iki path vermeye calisip
	# "wrong argument count" hatasi aldik, canli duzeltildi).
	@actuator path /actuator /actuator/*
	handle @actuator {
		reverse_proxy backend:8080
	}

	# Geri kalan her sey statik frontend build'i. try_files, dogrudan
	# /randevularim gibi bir SPA route'una gidildiginde (sayfa yenileme,
	# yer imi, dogrudan link) Caddy'nin bunu gercek bir dosya sanip 404
	# donmesini engelliyor -- eslesen dosya yoksa index.html'e duser,
	# React Router orada devreye girip dogru sayfayi render eder.
	handle {
		root * /srv/frontend
		try_files {path} /index.html
		file_server
	}
}

# www -> apex kalici yonlendirme. Beta'da adres sozlu tarif edilecek (bkz.
# RUNBOOK.md A3) -- biri "www" yazarsa hata sayfasi degil, dogru siteyi
# gormeli. www icin de DNS'te ayri bir kayit sart (A3), yoksa bu blok hic
# eslesmez -- Caddy kendisi bir alt domain "icat" etmez. Caddy bu ikinci
# site adresi icin de kendi sertifikasini otomatik yonetir, ayrica bir
# ayar gerekmiyor.
#
# AYRI bir degisken (WWW_DOMAIN), "www.{$DOMAIN}" DEGIL: yerel/dev'de DOMAIN
# varsayilani ":80" (duz HTTP portu) -- "www.:80" gecersiz bir site adresi
# olur ve Caddy hic ayaga kalkmaz. WWW_DOMAIN'in kendi varsayilani (bkz.
# docker-compose.yml) yerelde zararsiz, ayri bir porta denk gelecek sekilde
# secildi.
{$WWW_DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
